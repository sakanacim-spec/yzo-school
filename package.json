{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node validate-i18n.js && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "node backend/server.js",
    "start-all": "concurrently \"npm run dev\" \"node backend/server.js\"",
    "test:frontend": "node scripts/run-frontend-tests.cjs",
    "test:backend": "node scripts/run-backend-tests.cjs",
    "test:donations-backend": "node --test backend/tests/donationProposalAdminApi.test.js backend/tests/donationProposalAdminMigration.test.js backend/tests/donationProposalValidation.test.js backend/tests/donationProposalRoute.test.js",
    "test:ci-infrastructure": "node --test scripts/__tests__/runFrontendTests.test.cjs scripts/__tests__/runBackendTests.test.cjs scripts/__tests__/workflowIntegrity.test.cjs",
    "test:ci": "npm run typecheck && node validate-i18n.js && npm run test:ci-infrastructure && npm run test:frontend && npm run test:backend && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@google/genai": "^2.14.0",
    "@supabase/supabase-js": "^2.98.0",
    "@types/jspdf": "^1.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode.react": "^1.0.5",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^2.4.3",
    "clsx": "2.1.1",
    "cors": "^2.8.5",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "fedapay": "^1.2.5",
    "groq-sdk": "^1.5.0",
    "html5-qrcode": "^2.3.8",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^0.576.0",
    "multer": "^2.1.1",
    "puppeteer": "^25.4.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "3.4.0",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.2.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "2.3.0"
  }
}
